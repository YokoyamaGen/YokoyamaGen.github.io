[users]
  *id {label: "bigint, not null"}
  name {label: "varchar, null, uniq"}
  phone_number {label: "varchar, null, uniq"}
  full_name {label: "varchar, null"}
  self_introduction {label: "varchar"}
  location {label: "varchar"}
  website {label: "varchar"}
  date_birth {label: "date, null"}
  profile_image {label: "varchar"}
  avatar_image {label: "varchar"}
  email {label: "varchar, not null, uniq" }
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

[follows]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users)"}
  user_id {label: "bigint, not null, FK(users)"}
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

[tweets]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users)"}
  tweet {label: "varchar, not null"} 
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

[favorites]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users)"}
  tweet_id {label: "bigint, not null, FK(tweets)"}
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

[bookmarks]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users)"}
  tweet_id {label: "bigint, not null, FK(tweets)"}
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

[retweets]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users)"}
  tweet_id {label: "bigint, not null, FK(tweets)"}
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

[direct_messages]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users)"}
  user_id {label: "bigint, not null, FK(users)"}
  message {label: "varchar, null"} 
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

[notifications]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users)"}
  event_id {label: "bigint, not null"}
  event_table {label: "varchar, not null"}  
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

# Cardinality    Syntax
# 0 or 1         ?
# exactly 1      1
# 0 or more      *
# 1 or more      +
users 1--* `follows`
users 1--* `tweets`
users 1--* `favorites`
tweets 1--* `favorites`
users 1--* `bookmarks`
tweets 1--* `bookmarks`
users 1--* `retweets`
tweets 1--* `retweets`
users 1--* `direct_messages`
users 1--* `notifications`